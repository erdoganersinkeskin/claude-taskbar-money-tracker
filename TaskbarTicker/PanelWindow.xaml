<Window x:Class="TaskbarTicker.PanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TaskbarTicker"
        Title="Piyasalar"
        Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="True" ShowActivated="True"
        WindowStartupLocation="Manual"
        Background="Transparent">
    <!-- Sade şablon: Fluent temasının pencere şablonu kendi yarı saydam zeminini çizip camı koyulaştırıyor -->
    <Window.Template>
        <ControlTemplate TargetType="Window">
            <AdornerDecorator>
                <ContentPresenter />
            </AdornerDecorator>
        </ControlTemplate>
    </Window.Template>
    <Window.Resources>
        <!-- Satır: fareyle üzerine gelince hafif vurgu -->
        <Style x:Key="RowBorder" TargetType="Border">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="10,11" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <!-- Cam zemin: panel açılmadan hemen önce arkasında kalan ekran bölgesi yakalanır, bulanıklaştırılır
         ve üstüne okunurluk için ayarlanabilir bir ton konur (config: panelTintPercent). -->
    <Grid x:Name="Frame" ClipToBounds="True">
        <!-- Canvas içinde: zemin görüntüsü panelin yükseklik hesabına karışmasın (boyutu koddan verilir) -->
        <Canvas IsHitTestVisible="False">
            <Image x:Name="Backdrop" Stretch="Fill" Canvas.Left="-48" Canvas.Top="-48">
                <Image.Effect>
                    <BlurEffect Radius="36" KernelType="Gaussian" RenderingBias="Quality" />
                </Image.Effect>
            </Image>
        </Canvas>
        <Border x:Name="Tint" IsHitTestVisible="False" />
        <!-- Camın kenarında ince ışık çizgisi -->
        <Border BorderThickness="1" CornerRadius="8" BorderBrush="#26FFFFFF" IsHitTestVisible="False" />

        <StackPanel x:Name="Root">
            <!-- Başlık -->
            <Grid Margin="20,16,20,10">
                <TextBlock Text="Piyasalar" FontSize="16" FontWeight="Bold" />
                <TextBlock x:Name="StatusText" Text="Yükleniyor…" FontSize="12"
                           HorizontalAlignment="Right" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- Kalemler: ikon | ad + etiket | 24 saatlik grafik | fiyat + değişim -->
            <ItemsControl x:Name="Rows" Margin="8,0,8,8" Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type local:PanelRow}">
                        <StackPanel>
                            <!-- Satırlar arası ince ayraç (ilk satırda yok) -->
                            <Border x:Name="Divider" Height="1" Margin="12,0"
                                    Background="{DynamicResource DividerStrokeColorDefaultBrush}" />
                            <Border Style="{StaticResource RowBorder}" Opacity="{Binding Opacity}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" MinWidth="92" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Yuvarlak ikon: dış halka + renkli daire + simge -->
                                    <Grid Width="40" Height="40" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <Ellipse Fill="{DynamicResource SubtleFillColorSecondaryBrush}"
                                                 Stroke="{DynamicResource DividerStrokeColorDefaultBrush}" StrokeThickness="1" />
                                        <Ellipse Width="30" Height="30" Fill="{Binding Icon.Fill}" />
                                        <TextBlock Text="{Binding Icon.Text}" FontSize="{Binding Icon.TextSize}" FontWeight="Bold"
                                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   TextOptions.TextFormattingMode="Display" />
                                        <Path Data="{Binding Icon.Shape}" Fill="White" Width="17" Height="17" Stretch="Uniform"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>

                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="Bold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Label}" FontSize="12" Margin="0,1,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>

                                    <local:Sparkline Grid.Column="2" Height="30" Margin="4,0,14,0" VerticalAlignment="Center"
                                                     Values="{Binding Series}" Stroke="{Binding Trend}" />

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Price}" FontSize="15" FontWeight="Bold" HorizontalAlignment="Right" />
                                        <TextBlock Text="{Binding Change}" FontSize="12" FontWeight="SemiBold" Margin="0,2,0,0"
                                                   HorizontalAlignment="Right" Foreground="{Binding Trend}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding RelativeSource={RelativeSource PreviousData}}" Value="{x:Null}">
                                <Setter TargetName="Divider" Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Grid>
</Window>
